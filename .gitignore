# .gitignore — Aaroh
#
# Adapted from the AgentOS template .gitignore.
# Aaroh has not selected a technology stack yet, so patterns for several
# ecosystems are included pre-emptively. Prune this file once the stack is
# decided and recorded in an ADR.

# ─── Environment and Secrets ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.p12
*.keystore
*.jks
secrets/
credentials.json
service-account*.json

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ─── Node / JavaScript ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
.nuxt/
.svelte-kit/
.turbo/
.expo/
.expo-shared/

# ─── Build Output ──────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── OS and Editor ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Data and Large Files ──────────────────────────────────────────────────
*.csv
*.parquet
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
data/raw/
data/processed/

# ─── ML / AI Artifacts ─────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
*.bin
checkpoints/
runs/
wandb/
mlruns/
.neptune/

# ─── Infrastructure and Build ──────────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
.serverless/
.amplify/
cdk.out/

# ─── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Temporary and Cache ───────────────────────────────────────────────────
tmp/
temp/
.cache/
.tmp/
*.tmp
*.bak
*.orig

# ─── Local AI Assistant Config ─────────────────────────────────────────────
# Machine-local assistant settings — never shared
.claude/settings.local.json

# ─── Aaroh Specific ────────────────────────────────────────────────────────
# Add project-specific ignores below this line

# Supabase CLI local state (ADR-0061 I-11: dev/prod credential separation).
# .temp/ holds the linked-project pointer and CLI scratch data. It is machine-
# local, and future CLI versions may place credential-adjacent material here,
# so it is excluded rather than reviewed file-by-file.
supabase/.temp/
supabase/.branches/
